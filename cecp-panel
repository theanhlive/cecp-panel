#!/usr/bin/env bash
# CECP Panel — full standalone CLI (LarVPS-style workflow)
set -euo pipefail

if [[ -L "${BASH_SOURCE[0]}" ]]; then
  PANEL_ROOT="/opt/cecp-panel"
elif [[ -f "$(dirname "${BASH_SOURCE[0]}")/lib/common.sh" ]]; then
  PANEL_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
else
  PANEL_ROOT="/opt/cecp-panel"
fi

# shellcheck source=lib/common.sh
source "$PANEL_ROOT/lib/common.sh"
# shellcheck source=/dev/null
[[ -f "$PANEL_ROOT/lib/colors.sh" ]] && source "$PANEL_ROOT/lib/colors.sh"
source "$PANEL_ROOT/lib/mysql.sh"
source "$PANEL_ROOT/lib/ssl.sh"
source "$PANEL_ROOT/lib/site.sh"
source "$PANEL_ROOT/lib/backup.sh"
source "$PANEL_ROOT/lib/dns.sh"
source "$PANEL_ROOT/lib/security.sh"
source "$PANEL_ROOT/lib/system.sh"
source "$PANEL_ROOT/lib/agent.sh"
source "$PANEL_ROOT/lib/onboard.sh"
source "$PANEL_ROOT/lib/php_mgr.sh"
source "$PANEL_ROOT/lib/update.sh"
source "$PANEL_ROOT/lib/wordpress.sh"
source "$PANEL_ROOT/lib/optimize.sh"
source "$PANEL_ROOT/lib/cache.sh"
source "$PANEL_ROOT/lib/limits.sh"
source "$PANEL_ROOT/lib/staging.sh"
source "$PANEL_ROOT/lib/wpupdate.sh"
source "$PANEL_ROOT/lib/db.sh"
source "$PANEL_ROOT/lib/media.sh"
source "$PANEL_ROOT/lib/notify.sh"
source "$PANEL_ROOT/lib/monitor.sh"
source "$PANEL_ROOT/lib/cloudflare.sh"
source "$PANEL_ROOT/lib/modsec.sh"
source "$PANEL_ROOT/lib/logview.sh"
source "$PANEL_ROOT/lib/menu.sh"

CECP_PANEL_VERSION="${CECP_PANEL_VERSION:-1.10.0-beta}"

usage() {
  cat <<EOF
CECP Panel v$CECP_PANEL_VERSION

  cecp-panel                         Interactive menu
  cecp-panel status [--json]         Rich health status (--json: machine-readable, per-site details)

  cecp-panel site list|add|remove|duplicate|sftp-info|sftp-password|rebuild-vhost
    site staging DOMAIN [--name staging.DOMAIN] [--no-auth]      # clone to a protected, noindex copy
    site staging-push DOMAIN [--files-only|--db-only] [--dry-run] [--yes]
    site limits DOMAIN [--cpu 100] [--mem 1G] [--tasks 256] | off | show   # own PHP-FPM with CPU/RAM caps
    site auth DOMAIN on [--user NAME] | off | status | reset-password    # basic auth on the whole site
    site protect-admin DOMAIN on [--ip CIDR,...] [--no-auth] [--user NAME] | off | status | reset-password
    site add DOMAIN [--wordpress|--wp] [--php 82] [--ssl] [--redis] [--minimal]
      --wp alone also enables: cache auto-purge + 1h TTL, WordPress auto-update (minor only)
      --minimal skips those two (plain 5m cache, no auto-update)
  cecp-panel ssl list|issue|fix|renew|status|remove|hsts DOMAIN on|off|subdomains
    ssl issue DOMAIN [--dns] [--wildcard]      # DNS-01 via Cloudflare (no port 80 needed); wildcard = DOMAIN + *.DOMAIN
  cecp-panel dns list|add|point|ssl-mode
  cecp-panel cf status|purge|purge-url|realip|edge-cache|brotli|cache-level|recommend [args]
    cf edge-cache DOMAIN on [--ttl 1h] | off | status   # cache HTML at Cloudflare (logged-in/cart bypassed)
  cecp-panel cache status DOMAIN | purge [DOMAIN] | purge-url URL
    cache auto-purge DOMAIN on|off              # WordPress: purge changed pages on save/publish/comment
    cache ttl DOMAIN 5m|30m|1h|6h|1d            # origin page-cache lifetime
  cecp-panel backup setup|status|run|verify|list|prune|restore|enable-cron|...
    backup restore DOMAIN SNAPSHOT|latest [--live [--dry-run] [--yes]] [--target DIR] [--repo REPO]
    backup verify DOMAIN|--all
  cecp-panel security fail2ban|fail2ban-full|firewall|ssh|ssh-key-only|ssh-harden|ssh-repair
  cecp-panel security ssh-port|mariadb-bind|apply-production|check|unattended|fix-perms
  cecp-panel system info|ensure-swap|swap|disk-clean|maintain|tune
  cecp-panel mysql secure
  cecp-panel agent install|status
  cecp-panel onboard
  cecp-panel php list|install VER|set DOMAIN VER
    php config DOMAIN [memory_limit=512M upload_max_filesize=128M max_execution_time=300 ...] | DOMAIN --reset [KEY]
  cecp-panel update check|mirror|panel|component|os|wp-cli
    update all [--skip-os] [--skip-wp] [--skip-panel]   # OS + wp-cli + every WP site + panel
    update enable-cron|disable-cron                     # weekly (Sun 04:10 UTC) `update all`
  cecp-panel wp harden|optimize|cron|status DOMAIN
    wp update DOMAIN [--exclude a,b] [--no-major] [--dry-run]    # safety copy + health check + auto rollback
    wp auto-update DOMAIN on [--exclude a,b] [--no-major] | off | status
    wp rollback DOMAIN [--yes]                                   # undo the last update
  cecp-panel db export DOMAIN [FILE] | import DOMAIN FILE [--replace-url OLD] [--yes] | shell|info DOMAIN
    db size | slow-log on [SECONDS]|off|status | slow-report [TOP]
  cecp-panel optimize site|nginx|redis|redis-wp|redis-acl|mariadb|opcache|kernel|purge|purge-url|stack|bench|report|webp|brotli
  cecp-panel media enable|disable|status|run|run-all|enable-cron|disable-cron
    media enable DOMAIN [--max-width 1920] [--quality 80] [--no-upload] [--no-cron] [--no-webp] [--avif]
    media run DOMAIN [--dry-run] [--limit N]   # only if enabled for that site
  cecp-panel notify setup|status|test|health|enable-cron|disable-cron|webhook URL|off
  cecp-panel monitor run|status|enable|disable
  cecp-panel modsec status|install|enable|disable|blocking
  cecp-panel log panel|audit|nginx|php|mysql|fail2ban|notify [DOMAIN] [LINES]
EOF
}

site_add_with_flags() {
  local dom="${1:-}"
  shift || true
  [[ -n "$dom" ]] || panel_die "Usage: cecp-panel site add DOMAIN [--wordpress] [--php 82] [--ssl] [--redis] [--minimal]"
  local wp=n php_ver="" do_ssl=0 do_redis=0 smart=y
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --wordpress|--wp) wp=y; shift ;;
      --php)
        php_ver="${2:-}"; shift 2 || panel_die "--php requires version (81|82|83)"
        ;;
      --php=*) php_ver="${1#--php=}"; shift ;;
      --ssl) do_ssl=1; shift ;;
      --redis) do_redis=1; shift ;;
      --minimal) smart=n; shift ;;
      *) panel_die "Unknown flag: $1" ;;
    esac
  done
  site_add "$dom" "$wp" "$smart"
  if [[ -n "$php_ver" ]]; then
    php_set_site_version "$dom" "$php_ver"
  fi
  if [[ "$do_redis" == "1" ]]; then
    if [[ "$wp" =~ ^[yY] ]]; then
      optimize_redis_wp "$dom" || true
    else
      panel_log "WARN: --redis ignored (not WordPress)"
    fi
  fi
  if [[ "$do_ssl" == "1" ]]; then
    ssl_issue_for_domain "$dom" || panel_log "WARN: SSL issue failed for $dom (DNS ready?)"
  fi
  panel_log "site add complete: $dom wp=$wp php=${php_ver:-default} ssl=$do_ssl redis=$do_redis"
}

cmd="${1:-}"
shift || true

case "$cmd" in
  ""|menu) require_root; menu_main ;;
  status) if [[ "${1:-}" == "--json" ]]; then status_json; else show_status; fi ;;
  site)
    sub="${1:-}"; shift || true
    require_root
    case "$sub" in
      list) site_list ;;
      list-json) site_list_json ;;
      add)
        site_add_with_flags "$@"
        ;;
      remove) [[ -n "${1:-}" ]] && site_remove "$1" || panel_die "Usage: cecp-panel site remove DOMAIN" ;;
      duplicate)
        [[ -n "${1:-}" && -n "${2:-}" ]] || panel_die "Usage: cecp-panel site duplicate SRC DST [REPLACEMENTS_JSON]"
        site_duplicate "$1" "$2" "${3:-}"
        ;;
      sftp-info) [[ -n "${1:-}" ]] && site_sftp_info "$1" || panel_die "Usage: cecp-panel site sftp-info DOMAIN" ;;
      sftp-password) [[ -n "${1:-}" ]] && site_sftp_password "$1" "${2:-}" || panel_die "Usage: cecp-panel site sftp-password DOMAIN [PASS]" ;;
      protect-admin) site_protect_admin "$@" ;;
      auth) site_auth "$@" ;;
      limits) site_limits "$@" ;;
      staging) site_staging "$@" ;;
      staging-push) site_staging_push "$@" ;;
      rebuild-vhost)
        if [[ "${1:-}" == "--all" ]]; then site_rebuild_vhost_all
        elif [[ -n "${1:-}" ]]; then site_rebuild_vhost "$1"
        else panel_die "Usage: cecp-panel site rebuild-vhost DOMAIN|--all"
        fi
        ;;
      *) panel_die "Usage: cecp-panel site list|add|remove|duplicate|sftp-info|sftp-password|rebuild-vhost|protect-admin|auth|limits|staging|staging-push" ;;
    esac
    ;;
  ssl)
    sub="${1:-}"; shift || true
    require_root
    case "$sub" in
      list) ssl_list ;;
      issue) [[ -n "${1:-}" ]] && ssl_issue_for_domain "$@" || panel_die "Usage: cecp-panel ssl issue DOMAIN [--dns] [--wildcard]" ;;
      fix)
        if [[ "${1:-}" == "--all" ]]; then
          ssl_fix_all
        elif [[ -n "${1:-}" ]]; then
          auto="no"
          [[ "${2:-}" == "--auto" ]] && auto="yes"
          ssl_fix_for_domain "$1" "$auto"
        else
          panel_die "Usage: cecp-panel ssl fix DOMAIN [--auto] | --all"
        fi
        ;;
      renew) ssl_renew_all ;;
      status) ssl_status ;;
      remove) [[ -n "${1:-}" ]] && ssl_remove_for_domain "$1" || panel_die "Usage: cecp-panel ssl remove DOMAIN" ;;
      hsts) ssl_set_hsts "${1:-}" "${2:-}" ;;
      *) panel_die "Usage: cecp-panel ssl list|issue|fix|renew|status|remove|hsts" ;;
    esac
    ;;
  dns)
    sub="${1:-}"; shift || true
    require_root
    case "$sub" in
      list) dns_list_a ;;
      add)
        [[ -n "${1:-}" && -n "${2:-}" ]] || panel_die "Usage: cecp-panel dns add NAME IP [proxied]"
        dns_add_a "$1" "$2" "${3:-true}"
        ;;
      point) dns_point_site "${1:-}" "${2:-}" "${3:-}" ;;
      ssl-mode) dns_set_ssl_mode "${1:-}" "${2:-}" ;;
      *) panel_die "Usage: cecp-panel dns list|add|point|ssl-mode" ;;
    esac
    ;;
  cf|cloudflare)
    sub="${1:-}"; shift || true
    require_root
    case "$sub" in
      status) cf_status "${1:-}" ;;
      purge) cf_purge "${1:-all}" ;;
      purge-url) cf_purge_url "${1:-}" ;;
      realip) cf_realip_update ;;
      edge-cache) cf_edge_cache "$@" ;;
      brotli) cf_set_brotli "${1:-on}" "${2:-}" ;;
      cache-level) cf_set_cache_level "${1:-aggressive}" "${2:-}" ;;
      minify) cf_set_minify "${1:-}" ;;
      recommend|tips) cf_recommend ;;
      *) panel_die "Usage: cecp-panel cf status|purge|purge-url|realip|edge-cache|brotli|cache-level|recommend" ;;
    esac
    ;;
  cache)
    sub="${1:-}"; shift || true
    require_root
    case "$sub" in
      status) [[ -n "${1:-}" ]] && cache_status "$1" || panel_die "Usage: cecp-panel cache status DOMAIN" ;;
      auto-purge) cache_auto_purge "$@" ;;
      ttl) cache_ttl "$@" ;;
      purge) optimize_purge_cache "${1:-all}" ;;
      purge-url) optimize_purge_url "${1:-}" ;;
      purge-queue) cache_purge_queue "${1:-}" ;;
      *) panel_die "Usage: cecp-panel cache status|auto-purge|ttl|purge|purge-url DOMAIN ..." ;;
    esac
    ;;
  backup)
    sub="${1:-}"; shift || true
    require_root
    case "$sub" in
      setup) backup_setup ;;
      status) backup_status ;;
      policy) backup_policy_show ;;
      run)
        if [[ "${1:-}" == "--all" ]]; then backup_run_all
        elif [[ -n "${1:-}" ]]; then backup_run_one "$1"
        else panel_die "Usage: cecp-panel backup run DOMAIN|--all"
        fi
        ;;
      list) backup_list ;;
      list-json) backup_list_json "${1:-}" ;;
      config-get) backup_config_get ;;
      configure)
        [[ -n "${6:-}" ]] || panel_die "Usage: cecp-panel backup configure HOUR MINUTE DOW KEEP_DAILY KEEP_WEEKLY KEEP_MONTHLY [KEEP_YEARLY]"
        backup_configure "$1" "$2" "$3" "$4" "$5" "$6" "${7:-0}"
        ;;
      prune|forget) backup_apply_retention ;;
      prune-dry-run) backup_apply_retention --dry-run ;;
      restore) backup_restore "$@" ;;
      verify) backup_verify "${1:---all}" ;;
      enable-cron) backup_enable_cron ;;
      oauth-import)
        shift
        backup_oauth_import "${*:-}"
        ;;
      oauth-status) backup_oauth_status ;;
      *) panel_die "Usage: cecp-panel backup setup|status|oauth-import|oauth-status|run|verify|list|prune|restore|enable-cron" ;;
    esac
    ;;
  security)
    sub="${1:-}"; shift || true
    case "$sub" in
      fail2ban) security_fail2ban_status ;;
      fail2ban-full) require_root; security_fail2ban_full ;;
      firewall) security_firewall_status ;;
      ssh) security_ssh_show ;;
      ssh-key-only) require_root; security_apply_ssh_key_only ;;
      ssh-harden) require_root; security_ssh_harden ;;
      ssh-repair) require_root; security_ssh_repair ;;
      ssh-port) require_root; security_ssh_set_port "${1:-}" ;;
      mariadb-bind) require_root; security_mariadb_bind_local ;;
      apply-production) require_root; security_apply_production ;;
      check|self-check) security_self_check ;;
      unattended|auto-update) require_root; security_unattended_updates ;;
      fix-perms) require_root; security_fix_permissions ;;
      *) panel_die "Usage: cecp-panel security ...|unattended" ;;
    esac
    ;;
  system)
    sub="${1:-}"; shift || true
    case "$sub" in
      info) system_info ;;
      ensure-swap) require_root; system_swap_ensure ;;
      swap) require_root; system_swap_add "${1:-2}" ;;
      clean-logs) require_root; system_clean_logs ;;
      disk-clean) require_root; system_disk_clean ;;
      maintain) require_root; system_maintain ;;
      tune|tune-install) require_root; system_tune_install ;;
      enable-cron) require_root; system_enable_maintain_cron ;;
      *) panel_die "Usage: cecp-panel system info|ensure-swap|swap [GB]|disk-clean|maintain|tune" ;;
    esac
    ;;
  mysql)
    sub="${1:-secure}"; shift || true
    require_root
    case "$sub" in
      secure) mysql_secure_basics ;;
      *) panel_die "Usage: cecp-panel mysql secure" ;;
    esac
    ;;
  agent)
    sub="${1:-}"; shift || true
    case "$sub" in
      install) agent_install ;;
      status) agent_status ;;
      *) panel_die "Usage: cecp-panel agent install|status" ;;
    esac
    ;;
  onboard) onboard_main ;;
  wp)
    sub="${1:-}"; shift || true
    require_root
    case "$sub" in
      harden) [[ -n "${1:-}" ]] && wp_harden_site "$1" || panel_die "Usage: cecp-panel wp harden DOMAIN" ;;
      optimize) [[ -n "${1:-}" ]] && wp_optimize_site "$1" || panel_die "Usage: cecp-panel wp optimize DOMAIN" ;;
      cron) [[ -n "${1:-}" ]] && wp_install_system_cron "$1" || panel_die "Usage: cecp-panel wp cron DOMAIN" ;;
      status) [[ -n "${1:-}" ]] && wp_status_site "$1" || panel_die "Usage: cecp-panel wp status DOMAIN" ;;
      update) [[ -n "${1:-}" ]] && wp_update_site "$@" || panel_die "Usage: cecp-panel wp update DOMAIN [--exclude a,b] [--no-major] [--dry-run] | --scheduled" ;;
      auto-update) wp_auto_update "$@" ;;
      rollback) [[ -n "${1:-}" ]] && wp_update_rollback "$@" || panel_die "Usage: cecp-panel wp rollback DOMAIN [--yes]" ;;
      *) panel_die "Usage: cecp-panel wp harden|optimize|cron|status|update|auto-update|rollback DOMAIN" ;;
    esac
    ;;
  db)
    sub="${1:-}"; shift || true
    require_root
    case "$sub" in
      export) [[ -n "${1:-}" ]] && db_export "$@" || panel_die "Usage: cecp-panel db export DOMAIN [FILE.sql.gz]" ;;
      import) db_import "$@" ;;
      shell) db_shell "${1:-}" ;;
      info) db_info "${1:-}" ;;
      size) db_size ;;
      slow-log) db_slow_log "$@" ;;
      slow-report) db_slow_report "${1:-15}" ;;
      *) panel_die "Usage: cecp-panel db export|import|shell|info|size|slow-log|slow-report" ;;
    esac
    ;;
  optimize)
    sub="${1:-}"; shift || true
    require_root
    case "$sub" in
      site) [[ -n "${1:-}" ]] && optimize_site "$1" || panel_die "Usage: cecp-panel optimize site DOMAIN" ;;
      nginx) optimize_nginx_global ;;
      redis) optimize_install_redis ;;
      redis-wp) [[ -n "${1:-}" ]] && optimize_redis_wp "$1" || panel_die "Usage: cecp-panel optimize redis-wp DOMAIN" ;;
      redis-acl) [[ -n "${1:-}" ]] && optimize_redis_acl "$1" || panel_die "Usage: cecp-panel optimize redis-acl DOMAIN|--all" ;;
      mariadb) optimize_mariadb_tune ;;
      opcache|jit) optimize_opcache_jit ;;
      kernel|bbr) optimize_kernel_bbr ;;
      purge) optimize_purge_cache "${1:-all}" ;;
      purge-url) optimize_purge_url "${1:-}" ;;
      report) [[ -n "${1:-}" ]] && optimize_report "$1" "${2:-5000}" || panel_die "Usage: cecp-panel optimize report DOMAIN [LINES]" ;;
      stack) optimize_stack ;;
      bench) optimize_bench "${1:-}" ;;
      webp) [[ -n "${1:-}" ]] && optimize_webp "$1" || panel_die "Usage: cecp-panel optimize webp DOMAIN" ;;
      brotli) optimize_brotli ;;
      *) panel_die "Usage: cecp-panel optimize site|nginx|redis|redis-wp|redis-acl|mariadb|opcache|kernel|purge|purge-url|stack|bench|report|webp|brotli" ;;
    esac
    ;;
  media)
    sub="${1:-}"; shift || true
    require_root
    case "$sub" in
      enable)
        [[ -n "${1:-}" ]] || panel_die "Usage: cecp-panel media enable DOMAIN [--max-width N] [--quality N] [--no-upload] [--no-cron] [--no-webp]"
        media_enable "$@"
        ;;
      disable)
        [[ -n "${1:-}" ]] || panel_die "Usage: cecp-panel media disable DOMAIN"
        media_disable "$1"
        ;;
      status) media_status "${1:-}" ;;
      run)
        [[ -n "${1:-}" ]] || panel_die "Usage: cecp-panel media run DOMAIN [--dry-run] [--limit N]"
        media_run "$@"
        ;;
      run-all) media_run_all ;;
      enable-cron) media_enable_cron ;;
      disable-cron) media_disable_cron ;;
      *) panel_die "Usage: cecp-panel media enable|disable|status|run|run-all|enable-cron|disable-cron" ;;
    esac
    ;;
  notify)
    sub="${1:-}"; shift || true
    case "$sub" in
      setup) require_root; notify_setup ;;
      status) notify_status ;;
      test) require_root; notify_test ;;
      health) notify_health ;;
      enable-cron) require_root; notify_enable_cron ;;
      disable-cron) require_root; notify_disable_cron ;;
      send) notify_send "$*" ;;
      webhook) notify_webhook_set "${1:-}" ;;
      *) panel_die "Usage: cecp-panel notify setup|status|test|health|enable-cron|disable-cron|webhook URL|off" ;;
    esac
    ;;
  monitor)
    sub="${1:-status}"; shift || true
    case "$sub" in
      run) monitor_run ;;
      status) monitor_status ;;
      enable) monitor_enable ;;
      disable) monitor_disable ;;
      *) panel_die "Usage: cecp-panel monitor run|status|enable|disable" ;;
    esac
    ;;
  modsec|modsecurity)
    sub="${1:-}"; shift || true
    require_root
    case "$sub" in
      status) modsec_status ;;
      install) modsec_install ;;
      enable) modsec_enable ;;
      disable) modsec_disable ;;
      blocking|block) modsec_blocking ;;
      *) panel_die "Usage: cecp-panel modsec status|install|enable|disable|blocking" ;;
    esac
    ;;
  log|logs)
    log_view "${1:-panel}" "${2:-}" "${3:-80}"
    ;;
  php)
    sub="${1:-}"; shift || true
    require_root
    case "$sub" in
      list) php_list_versions ;;
      install) [[ -n "${1:-}" ]] && php_install_version "$1" || panel_die "Usage: cecp-panel php install 81|82|83" ;;
      set) [[ -n "${1:-}" && -n "${2:-}" ]] && php_set_site_version "$1" "$2" || panel_die "Usage: cecp-panel php set DOMAIN 82" ;;
      config) php_config "$@" ;;
      *) panel_die "Usage: cecp-panel php list|install|set|config" ;;
    esac
    ;;
  update)
    sub="${1:-}"; shift || true
    case "$sub" in
      check) update_check ;;
      mirror) require_root; update_mirror_set "${1:-}" ;;
      panel) require_root; update_panel "$@" ;;
      component) require_root; update_component "${1:-all}" ;;
      os) require_root; update_component os ;;
      wp-cli) require_root; wp_ensure_cli; wp_update_cli ;;
      all) update_all "$@" ;;
      enable-cron) update_all_enable_cron ;;
      disable-cron) update_all_disable_cron ;;
      *) panel_die "Usage: cecp-panel update check|mirror|panel|component|os|all|wp-cli|enable-cron|disable-cron" ;;
    esac
    ;;
  -h|--help|help) usage ;;
  *) usage; exit 1 ;;
esac
