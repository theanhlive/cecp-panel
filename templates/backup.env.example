# CECP Panel — Google Drive backup (chmod 600, root only)
# Copy to /etc/cecp-panel/backup.env and fill values.

# Auth mode: oauth (recommended, giống rclone config) | service_account (Shared Drive + SA JSON)
BACKUP_AUTH_MODE=oauth

# rclone remote name (generated into rclone.conf)
RCLONE_REMOTE=gdrive_cecp

# Folder on Google Drive (My Drive hoặc root của remote)
GDRIVE_FOLDER=CECP-VPS-Backups

# OAuth: token file (được CECP WebUI / oauth-import ghi tự động)
GDRIVE_OAUTH_TOKEN_FILE=/etc/cecp-panel/gdrive-oauth-token.json

# --- Chỉ khi BACKUP_AUTH_MODE=service_account ---
# GDRIVE_SERVICE_ACCOUNT_FILE=/etc/cecp-panel/gdrive-service-account.json
# GDRIVE_TEAM_DRIVE_ID=

# restic repo (default: rclone:REMOTE:FOLDER/hostname)
# RESTIC_REPOSITORY=rclone:gdrive_cecp:CECP-VPS-Backups/my-vps

# --- Retention (restic forget --prune) — cần backup HÀNG NGÀY để đủ 7 bản/tuần
# Quy tắc chuẩn CECP: daily=7 / weekly=6 / monthly=12
# ~7 bản trong 7 ngày gần nhất (1 bản/ngày)
RESTIC_KEEP_DAILY=7
# ~6 bản theo tuần (~1.5 tháng, ~4–6 điểm khôi phục trong 30 ngày)
RESTIC_KEEP_WEEKLY=6
# 12 bản theo tháng (~1 năm, tối thiểu 12 điểm khôi phục/năm)
RESTIC_KEEP_MONTHLY=12
# Tùy chọn: thêm snapshot theo năm (ngoài monthly)
# RESTIC_KEEP_YEARLY=3

# Giờ cron (cecp-panel backup configure / enable-cron)
# BACKUP_CRON_MINUTE=15
# BACKUP_CRON_HOUR=2
# BACKUP_CRON_DOW=*   # * = mỗi ngày; 0–6 = chủ nhật–thứ bảy (chạy 1 lần/tuần)
