# Optional Cloudflare API (chmod 600). Used by: cecp-panel dns / cf / ssl issue --dns / cache auto-purge
# Token permissions (scope: the zones you manage):
#   Zone → DNS → Edit            dns add/point, ssl issue --dns | --wildcard
#   Zone → Zone Settings → Edit  cf brotli / cache-level, dns ssl-mode
#   Zone → Cache Rules → Edit    cf edge-cache
#   Zone → Cache Purge → Purge   cf purge, auto-purge of the edge cache
CF_API_TOKEN=
# Default zone for short names (test2 → test2.theanhlive.com)
CF_DEFAULT_ZONE=theanhlive.com
