# CECP Panel notifications — configure with: cecp-panel notify setup (tokens pasted at a hidden prompt)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK=
# Zalo Bot (https://bot.zapps.vn): bot token + chat id (found automatically by: cecp-panel notify zalo)
ZALO_BOT_TOKEN=
ZALO_CHAT_ID=
# Generic JSON webhook (n8n …) — set with: cecp-panel notify webhook URL
WEBHOOK_URL=
WEBHOOK_SECRET=
# Which notifications: security uptime backup ssl resources updates (comma list) | all | none
NOTIFY_CATEGORIES=all
# Minimum severity: info | warning | critical
NOTIFY_MIN_SEVERITY=info
# Per channel overrides, e.g.: ZALO_CATEGORIES=security,uptime  TELEGRAM_MIN_SEVERITY=warning
SSL_WARN_DAYS=14
DISK_WARN_PCT=85
# Monitoring (cecp-panel monitor): hours without a successful backup before alerting
BACKUP_MAX_AGE_HOURS=36
