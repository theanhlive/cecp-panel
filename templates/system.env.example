# CECP Panel — system maintenance (chmod 600)
# Copy to /etc/cecp-panel/system.env or let: cecp-panel system tune-install

# Auto swap when total swap below this (MB)
SWAP_MIN_TOTAL_MB=512

# Target swap size rules (see system_swap_recommended_mb in lib/system.sh)
# Override cap (GB) for very large VPS
SWAP_MAX_GB=4

# Log retention
JOURNAL_RETENTION_DAYS=7
NGINX_LOG_RETENTION_DAYS=14
CECP_LOG_RETENTION_DAYS=30
PHP_FPM_LOG_RETENTION_DAYS=14

# Package manager cache
DNF_CLEAN=true
APT_CLEAN=true

# Only run aggressive cleanup when root disk use >= this percent
DISK_CLEAN_MIN_USE_PCT=70

# Truncate single log files larger than this (MB)
LOG_TRUNCATE_MB=50

# Weekly maintenance cron (UTC hour:minute)
MAINTAIN_CRON_HOUR=3
MAINTAIN_CRON_MINUTE=30
